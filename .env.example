# ================================
# Ticketmaster Discovery API
# Crie uma conta em: https://developer.ticketmaster.com
# e gere sua chave em: https://developer-acct.ticketmaster.com/user/login
# ================================
TICKETMASTER_API_KEY=SUA_CHAVE_AQUI

# ================================
# TMDB (The Movie Database) — API Read Access Token
# Gere em: https://www.themoviedb.org/settings/api (campo "API Read Access Token")
# ================================
TMDB_READ_ACCESS_TOKEN=SEU_TOKEN_AQUI

# ================================
# Stripe (modo de teste)
# Chave publicável (pk_test_...) em: https://dashboard.stripe.com/test/apikeys
# ================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_SUA_CHAVE_AQUI

# ================================
# Backend — URL pública usada pelo navegador para conectar no Socket.IO
# (mapa de assentos em tempo real). Em produção, aponte para a URL real do backend.
# ================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
