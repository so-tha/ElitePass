// ============================================================
// ElitePass — Prisma Schema
// Models: User, Event, Order, Ticket
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}



datasource db {
  provider = "postgresql"
}


// ─── Enums ───────────────────────────────────────────────────

enum Role {
  CLIENT
  ORGANIZER
  DOORMAN
}

enum EventType {
  SHOW
  MOVIE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

// ─── Models ──────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  cpf       String   @unique
  password  String   // bcrypt hash
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  events    Event[]
}

model Event {
  id          String      @id @default(uuid())
  organizerId String
  organizer   User        @relation(fields: [organizerId], references: [id])

  title       String
  description String?
  category    String      // Pop, Rock, Sertanejo, Cinema, etc.
  type        EventType   @default(SHOW)
  imageUrl    String?
  venue       String
  city        String
  date        DateTime

  capacity    Int         // Capacidade total de ingressos
  soldCount   Int         @default(0) // Ingressos já vendidos

  tiers       Json        // Array de tiers: [{ id, label, priceUnit, capacity }]

  status      EventStatus @default(PUBLISHED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders      Order[]
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])

  // Evento (local ou externo Ticketmaster/TMDB)
  eventId     String
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventType   EventType
  eventName   String
  eventDate   String?     // "YYYY-MM-DD"
  eventVenue  String?

  // Tier e preços
  tierId      String
  tierLabel   String
  priceUnit   Float
  quantity    Int
  fee         Float       // taxa de serviço cobrada (12%)
  totalAmount Float

  status      OrderStatus @default(CONFIRMED)
  createdAt   DateTime    @default(now())

  tickets     Ticket[]
}

model Ticket {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])

  // Código legível e token de compartilhamento
  code        String       @unique  // ex: "MIC-PI-20260817-432101"
  qrData      String       // conteúdo encodado no QR Code (= code + hash)
  shareToken  String       @unique @default(uuid())  // token público de compartilhamento

  status      TicketStatus @default(VALID)
  usedAt      DateTime?    // preenchido pela portaria ao validar

  createdAt   DateTime     @default(now())

  @@index([code])
  @@index([shareToken])
}

